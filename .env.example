# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Replit PostgreSQL connection string (postgres://user:pass@host:port/dbname)
DATABASE_URL="postgresql://user:password@localhost:5432/sona"

# SESSION_SECRET: Secret key used to sign HttpOnly session cookies
SESSION_SECRET="replace-with-a-long-random-secret"

# CLERK_SECRET_KEY / VITE_CLERK_PUBLISHABLE_KEY: Optional Clerk keys for Clerk JWT verification
CLERK_SECRET_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""

# ADMIN_BOOTSTRAP_CODE: Optional one-time invite code allowed when bootstrapping the first admin user
ADMIN_BOOTSTRAP_CODE=""

# RESEND_API_KEY / RESEND_FROM_EMAIL / ADMIN_ALERT_EMAIL: Phase 5 Resend email workflows (DMCA & alerts)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SONA <alerts@sonahub.app>"
ADMIN_ALERT_EMAIL=""

# CLOUDINARY_*: Avatar and crate cover image uploads (max 5MB)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SOUNDCLOUD_*: SoundCloud OAuth 2.1 credentials for live Liked Tracks sync
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""

